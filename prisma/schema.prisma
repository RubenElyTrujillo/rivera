generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ─── Contenido del sitio ──────────────────────────────────────────────────────

model HeroContent {
  id          Int    @id @default(autoincrement())
  subtitle    String
  titleLine1  String
  titleLine2  String
  description String
  imageUrl    String
}

model Service {
  id       Int    @id @default(autoincrement())
  icon     String
  title    String
  subtitle String
  desc     String
  order    Int    @default(0)
}

// ─── Catálogo 3 niveles ───────────────────────────────────────────────────────

model Categoria {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  coverImage    String?
  description   String?
  gridCols      Int            @default(3)
  subcategorias Subcategoria[]
}

model Subcategoria {
  id          Int        @id @default(autoincrement())
  categoriaId Int
  categoria   Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  name        String
  slug        String     @unique
  coverImage  String?
  description String?
  gridCols    Int        @default(3)
  productos   Producto[]

  @@index([categoriaId])
}

model Producto {
  id             Int              @id @default(autoincrement())
  subcategoriaId Int
  subcategoria   Subcategoria     @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)
  name           String
  slug           String           @unique
  coverImage     String?
  hoverImage     String?
  shortDesc      String?
  htmlContent    String?          @db.Text
  imagenes       ProductoImagen[]

  @@index([subcategoriaId])
}

model ProductoImagen {
  id         Int      @id @default(autoincrement())
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  url        String
  caption    String?
  order      Int      @default(0)

  @@index([productoId])
}

// ─── Navegación dinámica ──────────────────────────────────────────────────────

model NavItem {
  id          Int       @id @default(autoincrement())
  label       String
  href        String    @default("")
  slug        String?   @unique
  coverImage  String?
  description String?
  order       Int       @default(0)
  visible     Boolean   @default(true)
  parentId    Int?
  parent      NavItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    NavItem[] @relation("NavTree")

  @@index([parentId])
  @@index([slug])
}

// ─── Secciones del home (page builder) ───────────────────────────────────────

model PageSection {
  id      Int     @id @default(autoincrement())
  type    String
  order   Int     @default(0)
  visible Boolean @default(true)
  config  String  @default("{}")
}

model SpaceCategory {
  id         Int    @id @default(autoincrement())
  name       String
  slug       String @unique
  coverImage String @default("")
  order      Int    @default(0)
}

model SpaceProject {
  id          Int                 @id @default(autoincrement())
  title       String
  category    String
  imageUrl    String
  description String              @default("")
  completedAt DateTime?
  order       Int                 @default(0)
  images      SpaceProjectImage[]
}

model SpaceProjectImage {
  id             Int          @id @default(autoincrement())
  spaceProjectId Int
  spaceProject   SpaceProject @relation(fields: [spaceProjectId], references: [id], onDelete: Cascade)
  url            String
  caption        String       @default("")
  order          Int          @default(0)

  @@index([spaceProjectId])
}

model CatalogContent {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  pdfUrl      String
  buttonText  String @default("DESCARGAR CATÁLOGO PDF")
}

model ContactInfo {
  id             Int    @id @default(autoincrement())
  whatsappPhone  String
  phone1         String
  phone2         String @default("")
  email          String
  hoursText      String
  surfaceOptions String @default("[]")
}

model FooterContent {
  id       Int    @id @default(autoincrement())
  tagline  String
  services String @default("[]")
}

model SeoSettings {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  keywords    String
  ogImageUrl  String @default("")
}

model SiteConfig {
  id            Int     @id @default(autoincrement())
  showMaterials Boolean @default(true)
  showShowroom  Boolean @default(true)
}

model Media {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}
