generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ─── Contenido del sitio ──────────────────────────────────────────────────────

model HeroContent {
  id          Int    @id @default(autoincrement())
  subtitle    String
  titleLine1  String
  titleLine2  String
  description String
  imageUrl    String
}

model Service {
  id       Int    @id @default(autoincrement())
  icon     String
  title    String
  subtitle String
  desc     String
  order    Int    @default(0)
}

// ─── Categorías de producto (nivel 0) ────────────────────────────────────────

model Category {
  id         Int        @id @default(autoincrement())
  name       String
  slug       String     @unique
  coverImage String     @default("")
  icon       String     @default("")
  order      Int        @default(0)
  materials  Material[]
}

// ─── Materiales (nivel 1) ─────────────────────────────────────────────────────

model Material {
  id          Int                  @id @default(autoincrement())
  name        String
  slug        String               @unique
  subtitle    String               @default("")
  desc        String               @default("")
  spec        String               @default("")
  coverImage  String               @default("")
  order       Int                  @default(0)
  categoryId  Int?
  category    Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections MaterialCollection[]
  finishes    MaterialFinish[]

  @@index([categoryId])
}

model MaterialCollection {
  id         Int              @id @default(autoincrement())
  materialId Int
  material   Material         @relation(fields: [materialId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  desc       String           @default("")
  coverImage String           @default("")
  order      Int              @default(0)
  finishes   MaterialFinish[]

  @@unique([materialId, slug])
}

model MaterialFinish {
  id           Int                   @id @default(autoincrement())
  materialId   Int
  material     Material              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  collectionId Int
  collection   MaterialCollection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  slug         String                @unique
  code         String                @default("")
  image        String                @default("")
  hoverImage   String                @default("")
  dims         String                @default("")
  desc         String                @default("")
  order        Int                   @default(0)
  // Ficha técnica
  pdfUrl       String                @default("")
  thickness    String                @default("")
  useClass     String                @default("")
  waterRes     Boolean               @default(false)
  installType  String                @default("")
  warranty     String                @default("")
  specMd       String                @default("")
  images       MaterialFinishImage[]

  @@index([materialId])
  @@index([collectionId])
}

model MaterialFinishImage {
  id       Int            @id @default(autoincrement())
  finishId Int
  finish   MaterialFinish @relation(fields: [finishId], references: [id], onDelete: Cascade)
  url      String
  caption  String         @default("")
  order    Int            @default(0)

  @@index([finishId])
}

// ─── Navegación dinámica ──────────────────────────────────────────────────────

model NavItem {
  id       Int       @id @default(autoincrement())
  label    String
  href     String    @default("")
  order    Int       @default(0)
  visible  Boolean   @default(true)
  parentId Int?
  parent   NavItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavItem[] @relation("NavTree")

  @@index([parentId])
}

// ─── Secciones del home (page builder) ───────────────────────────────────────

model PageSection {
  id      Int     @id @default(autoincrement())
  type    String
  order   Int     @default(0)
  visible Boolean @default(true)
  config  String  @default("{}")
}

model SpaceCategory {
  id         Int    @id @default(autoincrement())
  name       String
  slug       String @unique
  coverImage String @default("")
  order      Int    @default(0)
}

model SpaceProject {
  id          Int                 @id @default(autoincrement())
  title       String
  category    String
  imageUrl    String
  description String              @default("")
  completedAt DateTime?
  order       Int                 @default(0)
  images      SpaceProjectImage[]
}

model SpaceProjectImage {
  id             Int          @id @default(autoincrement())
  spaceProjectId Int
  spaceProject   SpaceProject @relation(fields: [spaceProjectId], references: [id], onDelete: Cascade)
  url            String
  caption        String       @default("")
  order          Int          @default(0)

  @@index([spaceProjectId])
}

model CatalogContent {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  pdfUrl      String
  buttonText  String @default("DESCARGAR CATÁLOGO PDF")
}

model ContactInfo {
  id             Int    @id @default(autoincrement())
  whatsappPhone  String
  phone1         String
  phone2         String @default("")
  email          String
  hoursText      String
  surfaceOptions String @default("[]")
}

model FooterContent {
  id       Int    @id @default(autoincrement())
  tagline  String
  services String @default("[]")
}

model SeoSettings {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  keywords    String
  ogImageUrl  String @default("")
}

model SiteConfig {
  id            Int     @id @default(autoincrement())
  showMaterials Boolean @default(true)
  showShowroom  Boolean @default(true)
}

model Media {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}
