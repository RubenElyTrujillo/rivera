# ─── Base de datos PostgreSQL ─────────────────────────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://rivera:CAMBIA_ESTA_PASSWORD@postgres:5432/rivera"

# Variables individuales (usadas por docker-compose para crear el contenedor PG)
POSTGRES_DB=rivera
POSTGRES_USER=rivera
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

# ─── Autenticación JWT ────────────────────────────────────────────────────────
# Genera un secreto seguro con: openssl rand -base64 64
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO_Y_SEGURO

# ─── Admin inicial (usado en el seed) ────────────────────────────────────────
# Después del primer deploy puedes cambiar la contraseña desde el panel admin
ADMIN_EMAIL=admin@comercializadorarivera.com
ADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD_ADMIN

# ─── Dominio del sitio ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# ─── Webhook cotizaciones (Fase 2 - n8n) ─────────────────────────────────────
# N8N_WEBHOOK_URL=https://tudominio.com:5678/webhook/cotizacion
